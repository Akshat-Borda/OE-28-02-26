---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';

// Get all blogs and sort by date (newest first)
const posts = await getCollection('blog');
posts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const featuredPost = posts[0];
const restPosts = posts.slice(1);
---

<AppLayout title="Insights & Intelligence | OnLoop Energy" description="Read the latest engineering insights, strategies, and technical breakdowns from OnLoop Energy.">
  
  <section class="hero" style="min-height: auto; padding-top: calc(var(--header-height) + var(--space-12)); padding-bottom: var(--space-12); position: relative; overflow: hidden;">
    <div class="glow-orb glow-orb--teal" style="top: -100px; left: -100px;"></div>
    <div class="container" style="position: relative; z-index: 10;">
        <div class="hero__content" style="max-width: 800px;">
            <div class="hero__badge" style="margin-bottom: var(--space-6);">
                <span class="hero__badge-dot"></span>
                Editorial
            </div>
            <h1 class="hero__title" style="font-size: var(--font-size-6xl);">Energy <span class="hero__title-highlight">Intelligence</span></h1>
            <p class="hero__subtitle">
                Technical strategies, operational methodologies, and macroeconomic insights driving the future of commercial hybrid infrastructures.
            </p>
        </div>
    </div>
  </section>

  {/* Featured Post */}
  {featuredPost && (
    <section style="padding: 0 0 var(--space-16) 0;">
      <div class="container">
        <h3 style="font-size: var(--font-size-sm); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: var(--space-6);"></h3>
        <a href={`/blogs/${featuredPost.id}`} class="featured-card">
          <div class="featured-card__image-wrapper">
            <img 
              src={featuredPost.data.image || "https://images.unsplash.com/photo-1466611653911-95081537e5b7?w=1200&h=800&fit=crop"} 
              alt={featuredPost.data.title}
              class="featured-card__image"
              loading="lazy"
            />
          </div>
          <div class="featured-card__content">
            <div class="featured-card__meta">
              {featuredPost.data.tags?.[0] && (
                <span class="blog-tag">{featuredPost.data.tags[0]}</span>
              )}
              <span class="blog-date">{featuredPost.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
            <h2 class="featured-card__title">{featuredPost.data.title}</h2>
            <p class="featured-card__description">{featuredPost.data.description}</p>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: var(--space-6);">
              <div class="btn btn--primary" style="display: inline-flex;">Read Article</div>
              <span style="font-size: var(--font-size-sm); color: var(--color-text-muted); font-weight: 500;">By {featuredPost.data.author}</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  {/* Rest of the Posts */}
  {restPosts.length > 0 && (
    <section class="section section--light" style="position: relative;">
      <div class="glow-orb glow-orb--blue" style="top: 20%; right: -200px;"></div>
      <div class="container" style="position: relative; z-index: 10;">
        <h3 style="font-size: var(--font-size-2xl); margin-bottom: var(--space-8);">Latest Articles</h3>
        <div class="grid-3" style="gap: var(--space-8);">
          {restPosts.map(post => (
            <a href={`/blogs/${post.id}`} class="blog-card">
              <div class="blog-card__image-wrapper">
                <img 
                  src={post.data.image || "https://images.unsplash.com/photo-1509391366360-2e959784a276?w=800&h=500&fit=crop"} 
                  alt={post.data.title}
                  class="blog-card__image"
                  loading="lazy"
                />
              </div>
              <div class="blog-card__content">
                <div class="blog-card__meta">
                  <span style="font-size: var(--font-size-xs); color: var(--color-primary); font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">
                    {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </span>
                </div>
                <h3 class="blog-card__title">{post.data.title}</h3>
                <p class="blog-card__description" style="margin-bottom: var(--space-4);">{post.data.description}</p>
                <div style="margin-top: auto; padding-top: var(--space-4); border-top: 1px solid rgba(0,0,0,0.08); display: flex; align-items: center;">
                  <span style="font-size: var(--font-size-xs); color: var(--color-text-secondary); font-weight: 600;">By {post.data.author}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <style is:global>
    /* Premium Glassmorphic Featured Post */
    .featured-card {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: var(--radius-2xl);
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
      text-decoration: none;
      color: inherit;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .featured-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 30px 60px rgba(67, 176, 71, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .featured-card__image-wrapper {
      width: 100%;
      height: 100%;
      min-height: 400px;
      overflow: hidden;
    }

    .featured-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .featured-card:hover .featured-card__image {
      transform: scale(1.05);
    }

    .featured-card__content {
      padding: var(--space-12);
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.6) 100%);
    }

    .featured-card__meta {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
    }

    .blog-tag {
      background: var(--color-primary);
      color: white;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: var(--font-size-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .blog-date {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      font-weight: 500;
    }

    .featured-card__title {
      font-size: var(--font-size-4xl);
      line-height: 1.1;
      margin-bottom: var(--space-4);
      color: var(--color-primary-dark);
    }

    .featured-card__description {
      font-size: var(--font-size-lg);
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    /* Standard Blog Grid Cards */
    .blog-card {
      display: flex;
      flex-direction: column;
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.7);
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      text-decoration: none;
      color: inherit;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .blog-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px rgba(30, 115, 184, 0.1);
      border: 1px solid rgba(255, 255, 255, 1);
    }

    .blog-card__image-wrapper {
      width: 100%;
      aspect-ratio: 16/10;
      overflow: hidden;
    }

    .blog-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .blog-card:hover .blog-card__image {
      transform: scale(1.05);
    }

    .blog-card__content {
      padding: var(--space-6);
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .blog-card__meta {
      margin-bottom: var(--space-3);
    }

    .blog-card__title {
      font-size: var(--font-size-xl);
      line-height: 1.3;
      margin-bottom: var(--space-3);
      color: var(--color-text-primary);
    }

    .blog-card__description {
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
      line-height: 1.6;
      margin-bottom: 0;
    }

    /* Responsive adjustments */
    @media (max-width: 900px) {
      .featured-card {
        grid-template-columns: 1fr;
      }
      .featured-card__image-wrapper {
        min-height: 250px;
      }
      .featured-card__title {
        font-size: var(--font-size-3xl);
      }
    }
  </style>

</AppLayout>
