---
import { getCollection, render } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';

// This function tells Astro how many pages to generate at build time
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fallbackImage = "https://images.unsplash.com/photo-1466611653911-95081537e5b7?w=1600&h=900&fit=crop";
---

<AppLayout title={`${post.data.title} | OnLoop Energy`} description={post.data.description}>
  
  <article class="blog-reader">
    {/* Immersive Header */}
    <header class="blog-immersive-header">
      <div class="blog-immersive-header__bg">
        <img 
          src={post.data.image || fallbackImage} 
          alt={post.data.title} 
        />
        <div class="blog-immersive-header__overlay"></div>
      </div>
      
      <div class="container" style="position: relative; z-index: 10; height: 100%; display: flex; flex-direction: column; justify-content: center; padding-top: var(--space-12); padding-bottom: var(--space-8);">
        <div style="max-width: 800px;">
          <div style="margin-bottom: var(--space-6); display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
            {post.data.tags?.map((tag) => (
              <span class="blog-tag" style="background: rgba(255,255,255,0.15); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.4); color: white; padding: 6px 16px; border-radius: 30px; font-size: var(--font-size-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                {tag}
              </span>
            ))}
          </div>

          <h1 style="font-size: clamp(2.5rem, 5vw, 4.5rem); margin-bottom: var(--space-6); color: white; line-height: 1.1; text-shadow: 0 4px 20px rgba(0,0,0,0.5);">
            {post.data.title}
          </h1>
          
          <div style="display: flex; align-items: center; gap: var(--space-4); font-size: var(--font-size-md); color: rgba(255,255,255,0.8); font-weight: 500;">
            <span style="color: white; font-weight: 600;">By {post.data.author}</span>
            <span>•</span>
            <span>
              {post.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </span>
          </div>
        </div>
      </div>
    </header>

    {/* Reading Content */}
    <div class="blog-reader__body">
      <div class="container" style="max-width: 720px; padding: var(--space-16) var(--space-6);">
        <div class="blog-prose">
          <Content />
        </div>
      </div>
    </div>
  </article>

  {/* CSS specifically for the immersive reader and standard markdown HTML tags like <p>, <h2>, <blockquote> */}
  <style is:global>
    /* Header Styles */
    .blog-immersive-header {
      position: relative;
      height: 60vh;
      min-height: 450px;
      max-height: 700px;
      width: 100%;
      margin-top: 96px;
      display: flex;
    }

    .blog-immersive-header__bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .blog-immersive-header__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .blog-immersive-header__overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.4) 0%,
        rgba(0, 0, 0, 0.2) 40%,
        rgba(10, 25, 47, 0.9) 100%
      );
    }

    .blog-reader__body {
      background: var(--color-bg-light);
      position: relative;
      z-index: 20;
    }

    /* Markdown Rich Text Styling (Prose) */
    .blog-prose {
      font-size: 1.15rem;
      line-height: 1.8;
      color: var(--color-text-primary);
      font-family: var(--font-body);
    }
    .blog-prose h2 {
      font-size: 2.25rem;
      margin-top: 3.5rem;
      margin-bottom: 1.5rem;
      color: var(--color-charcoal);
      line-height: 1.3;
      letter-spacing: -0.02em;
    }
    .blog-prose h3 {
      font-size: 1.5rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      color: var(--color-text-primary);
    }
    .blog-prose p {
      margin-bottom: 1.75rem;
    }
    .blog-prose a {
      color: var(--color-primary);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
      transition: all 0.2s ease;
      font-weight: 500;
    }
    .blog-prose a:hover {
      color: var(--color-primary-dark);
      background-color: rgba(67, 176, 71, 0.1);
    }
    .blog-prose ul, .blog-prose ol {
      margin-bottom: 1.75rem;
      padding-left: 1.5rem;
    }
    .blog-prose li {
      margin-bottom: 0.5rem;
    }
    .blog-prose blockquote {
      border-left: 4px solid var(--color-primary);
      background: linear-gradient(to right, rgba(67, 176, 71, 0.05), transparent);
      padding: 1.5rem 2rem;
      font-style: italic;
      color: var(--color-primary-dark);
      margin: 2.5rem 0;
      font-size: 1.35rem;
      line-height: 1.6;
      border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    }
    .blog-prose strong {
      font-weight: 700;
      color: var(--color-charcoal);
    }
    .blog-prose img {
      border-radius: var(--radius-lg);
      margin: 3rem 0;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      width: 100%;
      height: auto;
    }
  </style>

</AppLayout>
