---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="BESS | OnLoop Energy" description="Custom-engineered commercial and industrial Battery Energy Storage Systems (BESS) designed to eliminate peak demand charges, ensure absolute grid resilience, and maximize resource ROI.">
<div>
  
  {/* Section 1: The Hero (Above the Fold) */}
  <section class="hero hero--short hero--image" style="background-image: url('https://images.unsplash.com/photo-1548613053-22087dd8edb8?w=1920&h=800&fit=crop'); background-position: center; position: relative;">
    <div class="glow-orb glow-orb--teal" style="top: 10%; left: 5%; z-index: 1;"></div>
    <div class="container" style="position: relative; z-index: 10;">
      <div class="grid-2" style="align-items: center; gap: var(--space-12);">
        <div class="hero__content" style="text-align: left; padding: 0;">
          <div class="hero__badge" style="margin-top: var(--space-6);">
            <span class="hero__badge-dot"></span>
            Battery Energy Storage Systems
          </div>
          <h1 class="hero__title" style="margin-bottom: var(--space-4);">
            Don't Just Generate Power.<br />
            <span class="hero__title-highlight">Command It.</span>
          </h1>
          <p class="hero__subtitle" style="font-size: var(--font-size-xl); max-width: 100%; margin-bottom: var(--space-8);">
            Custom-engineered Battery Energy Storage Systems (BESS) designed to eliminate peak demand charges, ensure absolute grid resilience, and maximize the ROI of your generation assets.
          </p>
          <div class="hero__actions" style="justify-content: flex-start;">
            <a href="#bess-form-section" class="btn btn--primary btn--large">Request a Feasibility & Load Analysis</a>
          </div>
        </div>
        
        {/* Sleek SVG Flow Animation */}
        <div class="bess-hero-flow visible scale-in pulse-glow">
          <svg class="bess-flow-svg" viewBox="0 0 400 240" fill="none" xmlns="http://www.w3.org/2000/svg">
            {/* Background grids */}
            <circle cx="200" cy="120" r="100" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" />
            
            {/* Generation Icon Group */}
            <g transform="translate(40, 60)">
              <circle cx="30" cy="30" r="28" fill="rgba(67, 176, 71, 0.15)" stroke="var(--color-green)" stroke-width="1.5" />
              {/* Solar Sun */}
              <circle cx="30" cy="30" r="10" fill="none" stroke="var(--color-green)" stroke-width="2" />
              <line x1="30" y1="12" x2="30" y2="16" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" />
              <line x1="30" y1="44" x2="30" y2="48" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" />
              <line x1="12" y1="30" x2="16" y2="30" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" />
              <line x1="44" y1="30" x2="48" y2="30" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" />
              <text x="30" y="72" fill="#ffffff" font-size="10" font-family="var(--font-family)" font-weight="600" text-anchor="middle">GENERATION</text>
            </g>

            {/* BESS Enclosure Cabinet */}
            <g transform="translate(300, 60)">
              <rect x="5" y="2" width="50" height="56" rx="4" fill="rgba(31, 183, 166, 0.15)" stroke="var(--color-teal)" stroke-width="1.5" />
              {/* Server-style Racks */}
              <line x1="12" y1="12" x2="48" y2="12" stroke="var(--color-teal)" stroke-width="2" />
              <line x1="12" y1="22" x2="48" y2="22" stroke="var(--color-teal)" stroke-width="2" />
              <line x1="12" y1="32" x2="48" y2="32" stroke="var(--color-teal)" stroke-width="2" />
              <line x1="12" y1="42" x2="48" y2="42" stroke="var(--color-teal)" stroke-width="2" />
              <line x1="12" y1="50" x2="35" y2="50" stroke="var(--color-green)" stroke-width="2" />
              {/* Power Indicator Light */}
              <circle cx="44" cy="50" r="2" fill="var(--color-green)" />
              <text x="30" y="72" fill="#ffffff" font-size="10" font-family="var(--font-family)" font-weight="600" text-anchor="middle">STORAGE</text>
            </g>

            {/* Control System Center */}
            <g transform="translate(170, 110)">
              <circle cx="30" cy="30" r="24" fill="rgba(30, 115, 184, 0.2)" stroke="var(--color-blue)" stroke-width="1.5" />
              <path d="M23 30h14M30 23v14" stroke="var(--color-blue)" stroke-width="2" stroke-linecap="round" />
              <text x="30" y="65" fill="#ffffff" font-size="9" font-family="var(--font-family)" font-weight="700" text-anchor="middle" letter-spacing="1">EMS CONTROL</text>
            </g>

            {/* Dash flow lines */}
            <path d="M100 90 C 130 90, 150 140, 170 140" fill="none" stroke="var(--color-green)" stroke-width="2" class="bess-flow-line" />
            <path d="M230 140 C 250 140, 270 90, 300 90" fill="none" stroke="var(--color-teal)" stroke-width="2" class="bess-flow-line" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  {/* Section 2: The Core Problem We Solve (Why BESS?) */}
  <section class="content-section fade-in">
    <div class="container">
      <div class="grid-2" style="align-items: center; gap: var(--space-12);">
        <div>
          <span class="content-section__label">Operational Buffer</span>
          <h2 class="content-section__title" style="margin-bottom: var(--space-6);">Solar and wind generate power when nature allows.<br /><span style="color: var(--color-primary);">BESS lets you deploy it when your business demands it.</span></h2>
          <p class="content-section__text" style="font-size: var(--font-size-lg); line-height: 1.7; color: var(--color-text-secondary);">
            For Commercial & Industrial (C&I) facilities, energy costs aren't just about total consumption—they are heavily driven by Peak Demand spikes. 
          </p>
          <p class="content-section__text" style="font-size: var(--font-size-lg); line-height: 1.7; color: var(--color-text-secondary); margin-top: var(--space-4);">
            Our storage systems act as a buffer, soaking up cheap or self-generated energy and discharging it instantly when grid prices spike or the grid goes down.
          </p>
        </div>

        {/* Dashboard Widget Style Line Graph */}
        <div class="peak-shaving-container">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); border-bottom: 1px solid rgba(0,0,0,0.06); padding-bottom: var(--space-2);">
            <h4 style="margin: 0; font-size: var(--font-size-base); color: var(--color-text-primary);">Peak Shaving Simulation</h4>
            <span style="font-size: 10px; font-weight: 700; color: var(--color-accent); text-transform: uppercase; background: var(--color-accent-subtle); padding: 2px 8px; border-radius: 4px;">Active Discharge</span>
          </div>
          
          <svg viewBox="0 0 400 220" width="100%" height="auto">
            {/* Grid lines */}
            <line x1="40" y1="40" x2="380" y2="40" class="chart-grid-line" />
            <line x1="40" y1="80" x2="380" y2="80" class="chart-grid-line" />
            <line x1="40" y1="120" x2="380" y2="120" class="chart-grid-line" />
            <line x1="40" y1="160" x2="380" y2="160" class="chart-grid-line" />
            
            {/* Threshold demand limit */}
            <line x1="40" y1="100" x2="380" y2="100" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="3, 3" />
            <text x="320" y="93" fill="#f43f5e" font-size="9" font-weight="700">BILLING THRESHOLD</text>

            {/* Area Shading under peak shaving */}
            {/* Shaved Peak Area */}
            <path d="M 160 100 L 160 80 Q 200 40, 240 80 L 240 100 Z" class="chart-shaved-area" />
            
            {/* Stored Battery Discharge Area */}
            <path d="M 160 100 Q 200 100, 240 100 L 240 120 Q 200 140, 160 120 Z" class="chart-stored-area" />

            {/* Load Curves */}
            {/* Raw Peak Load Curve */}
            <path d="M 40 160 Q 100 150, 140 110 T 200 50 T 260 110 T 380 160" fill="none" class="chart-line-demand" stroke-width="2" />
            
            {/* Dynamic Shaved Curve */}
            <path d="M 40 160 Q 100 150, 140 110 C 155 100, 160 100, 175 100 L 225 100 C 240 100, 245 100, 260 110 T 380 160" fill="none" class="chart-line-actual" stroke-width="2.5" />

            {/* Axes */}
            <line x1="40" y1="20" x2="40" y2="180" class="chart-axis" />
            <line x1="40" y1="180" x2="380" y2="180" class="chart-axis" />

            {/* Labels */}
            <text x="25" y="45" class="chart-text">100 kW</text>
            <text x="25" y="105" class="chart-text">50 kW</text>
            <text x="25" y="165" class="chart-text">0 kW</text>

            <text x="40" y="195" class="chart-text">08:00</text>
            <text x="200" y="195" class="chart-text" text-anchor="middle">14:00 (Peak Spike)</text>
            <text x="360" y="195" class="chart-text">20:00</text>
          </svg>

          <div style="display: flex; gap: var(--space-4); margin-top: var(--space-3); justify-content: center; font-size: var(--font-size-xs);">
            <div style="display: flex; align-items: center; gap: 6px;">
              <span style="width: 12px; height: 12px; border-radius: 2px; border: 1.5px dashed var(--color-blue); display: inline-block;"></span>
              <span style="color: var(--color-text-secondary); font-weight: 500;">Raw Site Load Spikes</span>
            </div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <span style="width: 12px; height: 12px; border-radius: 2px; background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); display: inline-block;"></span>
              <span style="color: var(--color-text-secondary); font-weight: 500;">Demand Spike Shaved</span>
            </div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <span style="width: 12px; height: 12px; border-radius: 2px; background: rgba(67, 176, 71, 0.2); border: 1px solid rgba(67, 176, 71, 0.4); display: inline-block;"></span>
              <span style="color: var(--color-text-secondary); font-weight: 500;">Stored Energy Deployment</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section 3: Applications & Use Cases */}
  <section class="content-section content-section--light fade-in">
    <div class="container">
      <div class="content-section__header">
        <span class="content-section__label">Functional Profiles</span>
        <h2 class="content-section__title">High-Value Applications</h2>
        <p class="content-section__text">How our custom storage architectures target and eliminate specific grid constraints.</p>
      </div>

      <div class="grid-2" style="gap: var(--space-8);">
        {/* Card 1 */}
        <div class="card" style="padding: var(--space-8);">
          <div class="card__icon" style="color: var(--color-primary); background: var(--color-accent-subtle); width: 48px; height: 48px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
              <line x1="18" y1="20" x2="18" y2="10" />
              <line x1="12" y1="20" x2="12" y2="4" />
              <line x1="6" y1="20" x2="6" y2="14" />
            </svg>
          </div>
          <h4 class="card__title" style="margin-bottom: var(--space-3);">Peak Shaving & Load Shifting</h4>
          <p class="card__text" style="color: var(--color-text-secondary); line-height: 1.6;">
            Automatically detect when your facility is about to cross into high-tariff peak usage thresholds. Your BESS instantly discharges to cap your grid draw, radically lowering demand charges.
          </p>
        </div>

        {/* Card 2 */}
        <div class="card" style="padding: var(--space-8);">
          <div class="card__icon" style="color: var(--color-primary); background: var(--color-accent-subtle); width: 48px; height: 48px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <path d="M12 8v4l3 3" />
            </svg>
          </div>
          <h4 class="card__title" style="margin-bottom: var(--space-3);">Microgrid & Absolute Backup</h4>
          <p class="card__text" style="color: var(--color-text-secondary); line-height: 1.6;">
            When the main grid fails, our systems transition to island mode within milliseconds. Your critical operations, machinery, and servers experience zero downtime.
          </p>
        </div>

        {/* Card 3 */}
        <div class="card" style="padding: var(--space-8);">
          <div class="card__icon" style="color: var(--color-primary); background: var(--color-accent-subtle); width: 48px; height: 48px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
            </svg>
          </div>
          <h4 class="card__title" style="margin-bottom: var(--space-3);">Renewable Integration</h4>
          <p class="card__text" style="color: var(--color-text-secondary); line-height: 1.6;">
            Stop curtailing (wasting) excess solar or wind power generated during low-load periods. Store your overproduction and use 100% of the green energy you pay to generate.
          </p>
        </div>

        {/* Card 4 */}
        <div class="card" style="padding: var(--space-8);">
          <div class="card__icon" style="color: var(--color-primary); background: var(--color-accent-subtle); width: 48px; height: 48px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
              <line x1="12" y1="1" x2="12" y2="23" />
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </div>
          <h4 class="card__title" style="margin-bottom: var(--space-3);">Arbitrage Optimization</h4>
          <p class="card__text" style="color: var(--color-text-secondary); line-height: 1.6;">
            For grid-connected facilities without generation, buy power from the utility when rates are lowest (overnight) and consume it during peak daytime billing hours.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Section 4: The OnLoop Engineering Standard (How We Do It Differently) */}
  <section class="content-section fade-in" style="background: linear-gradient(135deg, #0a2840 0%, #0f3d5c 100%); color: #ffffff;">
    <div class="container">
      <div class="content-section__header" style="max-width: 900px; text-align: left; margin-bottom: var(--space-12);">
        <span class="content-section__label" style="color: var(--color-teal); border-color: rgba(31, 183, 166, 0.3);">Our Rigour</span>
        <h2 class="content-section__title" style="color: #ffffff; font-size: var(--font-size-4xl);">We Don't Sell Batteries. We Engineer Storage Architecture.</h2>
      </div>

      <div class="grid-2" style="gap: var(--space-12); align-items: center;">
        <div>
          <p class="content-section__text" style="color: rgba(255,255,255,0.85); font-size: var(--font-size-lg); line-height: 1.8;">
            A battery is just hardware. A true BESS requires precise integration between the cells, the BMS (Battery Management System), the PCS (Power Conversion System/Inverters), and the EMS (Energy Management System) software.
          </p>
          <p class="content-section__text" style="color: rgba(255,255,255,0.85); font-size: var(--font-size-lg); line-height: 1.8; margin-top: var(--space-4);">
            Because OnLoop is entirely technology-agnostic, we don't force a single brand onto your site. We analyze your load profile, cycle-life requirements, and thermal environment to select and configure the optimal chemistry (LFP vs. NMC) and enclosure architecture for your exact financial goals.
          </p>
        </div>

        {/* 4-block architecture diagram */}
        <div style="background: rgba(255,255,255,0.05); padding: var(--space-6); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg);">
          <h4 style="color: var(--color-teal); font-size: var(--font-size-base); margin-bottom: var(--space-4); text-transform: uppercase; font-weight: 700; letter-spacing: 1px; text-align: center;">4-Tier Integration Stack</h4>
          
          <div style="display: flex; flex-direction: column; gap: var(--space-3);">
            <div style="background: rgba(255,255,255,0.06); padding: var(--space-3) var(--space-4); border-left: 4px solid var(--color-teal); border-radius: 4px;">
              <span style="font-size: 11px; font-weight: 700; color: var(--color-teal); text-transform: uppercase; display: block;">Tier 4: EMS (Energy Management System)</span>
              <span style="font-size: 13px; color: rgba(255,255,255,0.8);">Algorithmic billing optimization & dispatch control rules.</span>
            </div>
            
            <div style="background: rgba(255,255,255,0.06); padding: var(--space-3) var(--space-4); border-left: 4px solid var(--color-blue); border-radius: 4px;">
              <span style="font-size: 11px; font-weight: 700; color: var(--color-blue); text-transform: uppercase; display: block;">Tier 3: PCS (Power Conversion System)</span>
              <span style="font-size: 13px; color: rgba(255,255,255,0.8);">Millisecond-response bidirectional storage inverters.</span>
            </div>
            
            <div style="background: rgba(255,255,255,0.06); padding: var(--space-3) var(--space-4); border-left: 4px solid var(--color-green); border-radius: 4px;">
              <span style="font-size: 11px; font-weight: 700; color: var(--color-green); text-transform: uppercase; display: block;">Tier 2: BMS (Battery Management System)</span>
              <span style="font-size: 13px; color: rgba(255,255,255,0.8);">Cell monitoring, thermal protection, and degradation checks.</span>
            </div>
            
            <div style="background: rgba(255,255,255,0.06); padding: var(--space-3) var(--space-4); border-left: 4px solid #ffffff; border-radius: 4px;">
              <span style="font-size: 11px; font-weight: 700; color: #ffffff; text-transform: uppercase; display: block;">Tier 1: Lithium Cell Core (LFP / NMC)</span>
              <span style="font-size: 13px; color: rgba(255,255,255,0.8);">Agnostically curated cells suited strictly for the operating climate.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section 5: Seamless Integration (The OnLoop Lifecycle) */}
  <section class="content-section content-section--light fade-in">
    <div class="container">
      <div class="content-section__header" style="max-width: 900px;">
        <span class="content-section__label">System Integration</span>
        <h2 class="content-section__title">The Storage Engineering Lifecycle</h2>
        <p class="content-section__text">We take absolute accountability for BESS lifecycle stages, mapping system performance to site loads.</p>
      </div>

      <div class="grid-4" style="align-items: stretch; gap: var(--space-6);">
        {/* Step 1 */}
        <div class="feature-item" style="flex-direction: column; align-items: flex-start; gap: var(--space-4); background: #ffffff; padding: var(--space-6); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
          <div class="feature-item__icon" style="width: 32px; height: 32px; font-weight: 800; font-size: 0.95rem; background: var(--color-accent-subtle); color: var(--color-primary);">1</div>
          <div>
            <span style="font-size: 10px; font-weight: 700; color: var(--color-teal); text-transform: uppercase; display: block; margin-bottom: 2px;">Data Gathering</span>
            <h4 style="font-size: var(--font-size-base); margin-bottom: var(--space-2); color: var(--color-text-primary);">Load Profile Assessment</h4>
            <p class="feature-item__text" style="font-size: 13px; line-height: 1.6; color: var(--color-text-secondary);">We don't guess your capacity. We pull your granular historical interval data to map your exact power (kW) and energy (kWh) requirements.</p>
          </div>
        </div>

        {/* Step 2 */}
        <div class="feature-item" style="flex-direction: column; align-items: flex-start; gap: var(--space-4); background: #ffffff; padding: var(--space-6); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
          <div class="feature-item__icon" style="width: 32px; height: 32px; font-weight: 800; font-size: 0.95rem; background: var(--color-accent-subtle); color: var(--color-primary);">2</div>
          <div>
            <span style="font-size: 10px; font-weight: 700; color: var(--color-teal); text-transform: uppercase; display: block; margin-bottom: 2px;">Simulation</span>
            <h4 style="font-size: var(--font-size-base); margin-bottom: var(--space-2); color: var(--color-text-primary);">System Modeling</h4>
            <p class="feature-item__text" style="font-size: 13px; line-height: 1.6; color: var(--color-text-secondary);">Using advanced financial and thermodynamic modeling, we run simulations to find the exact "sweet spot" of battery capacity that yields the highest Internal Rate of Return (IRR).</p>
          </div>
        </div>

        {/* Step 3 */}
        <div class="feature-item" style="flex-direction: column; align-items: flex-start; gap: var(--space-4); background: #ffffff; padding: var(--space-6); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
          <div class="feature-item__icon" style="width: 32px; height: 32px; font-weight: 800; font-size: 0.95rem; background: var(--color-accent-subtle); color: var(--color-primary);">3</div>
          <div>
            <span style="font-size: 10px; font-weight: 700; color: var(--color-teal); text-transform: uppercase; display: block; margin-bottom: 2px;">Deployment</span>
            <h4 style="font-size: var(--font-size-base); margin-bottom: var(--space-2); color: var(--color-text-primary);">Compliance & EPC Build</h4>
            <p class="feature-item__text" style="font-size: 13px; line-height: 1.6; color: var(--color-text-secondary);">From fire-suppression system safety compliance to complex utility interconnection agreements, our in-house engineering team handles the entire physical installation.</p>
          </div>
        </div>

        {/* Step 4 */}
        <div class="feature-item" style="flex-direction: column; align-items: flex-start; gap: var(--space-4); background: #ffffff; padding: var(--space-6); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
          <div class="feature-item__icon" style="width: 32px; height: 32px; font-weight: 800; font-size: 0.95rem; background: var(--color-accent-subtle); color: var(--color-primary);">4</div>
          <div>
            <span style="font-size: 10px; font-weight: 700; color: var(--color-teal); text-transform: uppercase; display: block; margin-bottom: 2px;">Lifecycle Management</span>
            <h4 style="font-size: var(--font-size-base); margin-bottom: var(--space-2); color: var(--color-text-primary);">EMS Tuning & O&M</h4>
            <p class="feature-item__text" style="font-size: 13px; line-height: 1.6; color: var(--color-text-secondary);">We program the Energy Management System algorithms to continuously adapt to changing utility tariffs and operational loads, ensuring your battery degrades as slowly as possible while saving you the most money.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Section 6: Load Analysis Request Form (Pre-hook) */}
  <section class="content-section" id="bess-form-section" style="scroll-margin-top: calc(var(--header-height) + 20px);">
    <div class="container container--narrow">
      <div style="text-align: center; margin-bottom: var(--space-10);">
        <span class="content-section__label">Complimentary Simulation</span>
        <h2 class="content-section__title">Ready to make your energy infrastructure bulletproof?</h2>
        <p class="content-section__text">Let our engineering team run a complimentary high-level storage simulation based on your current utility bills and load profile.</p>
      </div>

      <div class="contact-form" style="background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border: 1px solid var(--glass-border); padding: var(--space-8); border-radius: var(--radius-xl); box-shadow: var(--shadow-md);">
        
        {/* Form Submission Dynamic Alert Block */}
        <div id="bess-form-alert" style="display: none; padding: 1rem; margin-bottom: 1.5rem; border-radius: 8px; font-size: 0.95rem;"></div>

        <form id="bess-simulation-form">
          <div class="grid-2" style="gap: var(--space-4);">
            <div class="form-group" style="margin-bottom: var(--space-4);">
              <label class="form-label" style="font-weight: 600;">Contact Name</label>
              <input type="text" id="bess-name" class="form-input" required placeholder="Your Name" />
            </div>
            
            <div class="form-group" style="margin-bottom: var(--space-4);">
              <label class="form-label" style="font-weight: 600;">Company Name</label>
              <input type="text" id="bess-company" class="form-input" required placeholder="Your Company" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: var(--space-6);">
            <label class="form-label" style="font-weight: 600;">Average Monthly Electric Bill ($)</label>
            <input type="number" id="bess-bill" class="form-input" required placeholder="e.g. 15000" min="1" />
          </div>

          <div class="grid-2" style="gap: var(--space-4); margin-bottom: var(--space-6);">
            <div class="form-group">
              <label class="form-label" style="font-weight: 600;">Email Address</label>
              <input type="email" id="bess-email" class="form-input" required placeholder="your@email.com" />
            </div>
            
            <div class="form-group">
              <label class="form-label" style="font-weight: 600;">Contact Number</label>
              <input type="tel" id="bess-phone" class="form-input" required placeholder="e.g. +91 98765 43210" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom: var(--space-6);">
            <label class="form-label" style="font-weight: 600;">Operational Context / Target Objectives</label>
            <textarea id="bess-message" class="form-textarea" placeholder="Describe any specific peak constraints, grid dropouts, or generation resources currently on-site..." style="height: 100px;"></textarea>
          </div>

          <button type="submit" class="btn btn--primary btn--large" style="width: 100%; justify-content: center;">
            Submit Simulation Request
          </button>
        </form>
      </div>
    </div>
  </section>

</div>

{/* Custom Page Script Block for BESS Interactivity */}
<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // BESS Form Validation and Simulation submission
    const form = document.getElementById('bess-simulation-form');
    const alertBlock = document.getElementById('bess-form-alert');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = document.getElementById('bess-name').value.trim();
        const company = document.getElementById('bess-company').value.trim();
        const email = document.getElementById('bess-email').value.trim();
        const phone = document.getElementById('bess-phone').value.trim();
        const bill = document.getElementById('bess-bill').value.trim();
        const message = document.getElementById('bess-message').value.trim();

        if (!name || !company || !email || !phone || !bill) {
          alertBlock.textContent = "❌ Please fill out all required fields.";
          alertBlock.style.background = "rgba(239, 68, 68, 0.1)";
          alertBlock.style.border = "1px solid rgba(239, 68, 68, 0.3)";
          alertBlock.style.color = "#ef4444";
          alertBlock.style.display = "block";
          return;
        }

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;

        submitBtn.innerHTML = '<span style="display: inline-flex; align-items: center; gap: 8px;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Submitting Profile...</span>';
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';

        // Use FormData instead of JSON body to prevent preflight OPTIONS requests (which fail CORS policies on localhost)
        const formData = new FormData();
        formData.append('Name', name);
        formData.append('Company', company);
        formData.append('Email Address', email);
        formData.append('Contact Number', phone);
        formData.append('Average Monthly Electric Bill ($)', bill);
        formData.append('Objectives / Operational Context', message);
        formData.append('_subject', `New BESS Simulation Request from ${company}`);
        formData.append('_captcha', 'false');
        formData.append('_template', 'table');

        try {
          const response = await fetch('https://formsubmit.co/ajax/info@onloopenergy.com', {
            method: 'POST',
            body: formData,
            // DO NOT set Content-Type header. Fetch automatically configures it as multipart/form-data which is a "simple request" and has no CORS preflight.
          });

          if (response.ok) {
            form.reset();
            
            alertBlock.textContent = "✅ Success! Our engineering team has received your profile. We are running load simulations and will return a complete BESS analysis to you in 2-3 business days.";
            alertBlock.style.background = "rgba(16, 185, 129, 0.1)";
            alertBlock.style.border = "1px solid rgba(16, 185, 129, 0.3)";
            alertBlock.style.color = "#10b981";
            alertBlock.style.display = "block";

            submitBtn.innerHTML = '✅ Simulation Request Sent!';
            submitBtn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
            submitBtn.style.opacity = '1';

            setTimeout(() => {
              submitBtn.innerHTML = originalText;
              submitBtn.disabled = false;
              submitBtn.style.background = '';
              alertBlock.style.display = "none";
            }, 5000);
          } else {
            throw new Error('FormSubmit response error');
          }
        } catch (err) {
          alertBlock.textContent = "❌ Submission failed. Please verify your internet connection or email us directly at info@onloopenergy.com";
          alertBlock.style.background = "rgba(239, 68, 68, 0.1)";
          alertBlock.style.border = "1px solid rgba(239, 68, 68, 0.3)";
          alertBlock.style.color = "#ef4444";
          alertBlock.style.display = "block";
          
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
          submitBtn.style.opacity = '1';
        }
      });
    }
  });
</script>
</AppLayout>
