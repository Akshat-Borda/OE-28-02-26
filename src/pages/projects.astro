---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Real Projects & Case Studies Grid | OnLoop Energy" description="Explore real project case studies across India. Review system sizes, monthly bill offsets, and realistic ROI metrics for textile, ceramics, chemical, food processing, cold storage, and metal facilities.">
<div>

  {/* Hero Section */}
  <section class="hero hero--short">
    <div class="container">
      <div class="hero__content">
        <div class="hero__badge" style="margin-top: var(--space-12);">
          <span class="hero__badge-dot"></span>
          Proven Project Portfolio
        </div>
        <h1 class="hero__title">
          Real Projects. Real Results.<br />
          <span class="hero__title-highlight">Across Manufacturing Belts in India.</span>
        </h1>
        <p class="hero__subtitle">We work with manufacturers across India — textile, ceramics, chemical, food processing, cold storage, and heavy engineering. Each project below was engineered based on load profile analysis and tariff structure.</p>
      </div>
    </div>
  </section>

  {/* Exclusion Statement Trust Banner */}
  <div style="background: rgba(31, 183, 166, 0.08); border-top: 1px solid rgba(31, 183, 166, 0.2); border-bottom: 1px solid rgba(31, 183, 166, 0.2); padding: var(--space-4) 0;">
    <div class="container" style="text-align: center;">
      <p style="margin: 0; font-weight: 600; font-size: var(--font-size-base); color: var(--color-text-primary);">
        <strong>Exclusively Private B2B:</strong> All projects below are private Commercial, Industrial, and MSME captive plants (> ₹10 Lakhs monthly bill). No residential. No government tenders.
      </p>
    </div>
  </div>

  {/* Case Study Grid Section */}
  <section class="content-section fade-in" style="padding: var(--space-12) 0;">
    <div class="container">
      <div class="content-section__header" style="text-align: left; margin-bottom: var(--space-8);">
        <span class="content-section__label">Case Study Grid</span>
        <h2 class="content-section__title">Featured Industrial Projects</h2>
        <p class="content-section__text">Click "See Details" on any project card to review complete load profile challenges, before vs after utility bills, and financial ROI breakdowns.</p>
      </div>

      <div class="grid-3" style="gap: var(--space-8);">

        {/* Card 1: Textile Dyeing Surat */}
        <div class="card" style="padding: var(--space-6); background: #ffffff; border-top: 5px solid var(--color-primary); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
              <div>
                <span style="font-size: 11px; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.5px;">📍 Surat, India</span>
                <h3 style="font-size: var(--font-size-xl); margin: 2px 0 0 0;">Textile & Dyeing Unit</h3>
              </div>
              <span style="font-size: 1.8rem;">🧵</span>
            </div>

            <div style="background: var(--color-bg-light); padding: 12px; border-radius: 8px; margin-bottom: 16px;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;">
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">System Type</span>
                  <strong style="color: var(--color-text-primary);">1.2MW Hybrid</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Bill Offset</span>
                  <strong style="color: var(--color-primary);">72% Offset</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Savings</span>
                  <strong style="color: #10b981;">₹4.2 Lakhs / mo</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Payback Period</span>
                  <strong style="color: var(--color-text-primary);">~4.2 Years</strong>
                </div>
              </div>
            </div>

            <p style="font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: 16px;">
              Continuous 24/7 dyeing jets offset night shift electricity grid tariffs while cutting diesel generator reliance by 94%.
            </p>
          </div>

          <a href="/projects/textile-dyeing-surat" class="btn btn--primary" style="width: 100%; justify-content: center;">
            See Details →
          </a>
        </div>

        {/* Card 2: Ceramics Morbi */}
        <div class="card" style="padding: var(--space-6); background: #ffffff; border-top: 5px solid var(--color-primary); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
              <div>
                <span style="font-size: 11px; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.5px;">📍 Morbi, India</span>
                <h3 style="font-size: var(--font-size-xl); margin: 2px 0 0 0;">Ceramics & Tiles Plant</h3>
              </div>
              <span style="font-size: 1.8rem;">🧱</span>
            </div>

            <div style="background: var(--color-bg-light); padding: 12px; border-radius: 8px; margin-bottom: 16px;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;">
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">System Type</span>
                  <strong style="color: var(--color-text-primary);">1.5MW Hybrid</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Bill Offset</span>
                  <strong style="color: var(--color-primary);">73% Offset</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Savings</span>
                  <strong style="color: #10b981;">₹4.8 Lakhs / mo</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Payback Period</span>
                  <strong style="color: var(--color-text-primary);">~4.6 Years</strong>
                </div>
              </div>
            </div>

            <p style="font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: 16px;">
              Flattened peak demand for continuous 24/7 roller kilns while reducing peak demand penalty surcharges by 71%.
            </p>
          </div>

          <a href="/projects/ceramics-morbi" class="btn btn--primary" style="width: 100%; justify-content: center;">
            See Details →
          </a>
        </div>

        {/* Card 3: Chemical Ankleshwar */}
        <div class="card" style="padding: var(--space-6); background: #ffffff; border-top: 5px solid var(--color-primary); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
              <div>
                <span style="font-size: 11px; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.5px;">📍 Ankleshwar, India</span>
                <h3 style="font-size: var(--font-size-xl); margin: 2px 0 0 0;">Chemical Processing Unit</h3>
              </div>
              <span style="font-size: 1.8rem;">🧪</span>
            </div>

            <div style="background: var(--color-bg-light); padding: 12px; border-radius: 8px; margin-bottom: 16px;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;">
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">System Type</span>
                  <strong style="color: var(--color-text-primary);">2MW Pure Wind</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Bill Offset</span>
                  <strong style="color: var(--color-primary);">63% Offset</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Savings</span>
                  <strong style="color: #10b981;">₹6.0 Lakhs / mo</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Payback Period</span>
                  <strong style="color: var(--color-text-primary);">~4.0 Years</strong>
                </div>
              </div>
            </div>

            <p style="font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: 16px;">
              Direct-drive wind system provides 24/7 power security for continuous chiller loads, reducing power outage downtime by 87%.
            </p>
          </div>

          <a href="/projects/chemical-ankleshwar" class="btn btn--primary" style="width: 100%; justify-content: center;">
            See Details →
          </a>
        </div>

        {/* Card 4: Food Processing Maharashtra */}
        <div class="card" style="padding: var(--space-6); background: #ffffff; border-top: 5px solid var(--color-primary); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
              <div>
                <span style="font-size: 11px; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.5px;">📍 Maharashtra, India</span>
                <h3 style="font-size: var(--font-size-xl); margin: 2px 0 0 0;">Food Processing Facility</h3>
              </div>
              <span style="font-size: 1.8rem;">🍲</span>
            </div>

            <div style="background: var(--color-bg-light); padding: 12px; border-radius: 8px; margin-bottom: 16px;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;">
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">System Type</span>
                  <strong style="color: var(--color-text-primary);">900KW Hybrid</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Bill Offset</span>
                  <strong style="color: var(--color-primary);">71% Offset</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Savings</span>
                  <strong style="color: #10b981;">₹3.2 Lakhs / mo</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Payback Period</span>
                  <strong style="color: var(--color-text-primary);">~4.5 Years</strong>
                </div>
              </div>
            </div>

            <p style="font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: 16px;">
              Powers 24/7 refrigeration loads across monsoon solar dips, eliminating food spoilage risks and cutting grid energy bills.
            </p>
          </div>

          <a href="/projects/food-processing" class="btn btn--primary" style="width: 100%; justify-content: center;">
            See Details →
          </a>
        </div>

        {/* Card 5: Cold Storage Rajasthan */}
        <div class="card" style="padding: var(--space-6); background: #ffffff; border-top: 5px solid var(--color-primary); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
              <div>
                <span style="font-size: 11px; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.5px;">📍 Rajasthan, India</span>
                <h3 style="font-size: var(--font-size-xl); margin: 2px 0 0 0;">Cold Storage Plant</h3>
              </div>
              <span style="font-size: 1.8rem;">❄️</span>
            </div>

            <div style="background: var(--color-bg-light); padding: 12px; border-radius: 8px; margin-bottom: 16px;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;">
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">System Type</span>
                  <strong style="color: var(--color-text-primary);">1MW Hybrid</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Bill Offset</span>
                  <strong style="color: var(--color-primary);">72% Offset</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Savings</span>
                  <strong style="color: #10b981;">₹3.8 Lakhs / mo</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Payback Period</span>
                  <strong style="color: var(--color-text-primary);">~4.3 Years</strong>
                </div>
              </div>
            </div>

            <p style="font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: 16px;">
              Provides 24/7 cooling power for high base refrigeration loads while cutting diesel generator fuel consumption by 90%.
            </p>
          </div>

          <a href="/projects/cold-storage" class="btn btn--primary" style="width: 100%; justify-content: center;">
            See Details →
          </a>
        </div>

        {/* Card 6: Engineering Metal Tamil Nadu */}
        <div class="card" style="padding: var(--space-6); background: #ffffff; border-top: 5px solid var(--color-primary); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
              <div>
                <span style="font-size: 11px; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.5px;">📍 Tamil Nadu, India</span>
                <h3 style="font-size: var(--font-size-xl); margin: 2px 0 0 0;">Engineering & Metal Unit</h3>
              </div>
              <span style="font-size: 1.8rem;">⚙️</span>
            </div>

            <div style="background: var(--color-bg-light); padding: 12px; border-radius: 8px; margin-bottom: 16px;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;">
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">System Type</span>
                  <strong style="color: var(--color-text-primary);">1.8MW Hybrid</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Bill Offset</span>
                  <strong style="color: var(--color-primary);">74% Offset</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Monthly Savings</span>
                  <strong style="color: #10b981;">₹5.5 Lakhs / mo</strong>
                </div>
                <div>
                  <span style="color: var(--color-text-secondary); display: block; font-size: 11px;">Payback Period</span>
                  <strong style="color: var(--color-text-primary);">~4.1 Years</strong>
                </div>
              </div>
            </div>

            <p style="font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: 16px;">
              Engineered for heavy induction furnace machinery, eliminating power quality grid trips and daytime peak surcharges.
            </p>
          </div>

          <a href="/projects/engineering-metal" class="btn btn--primary" style="width: 100%; justify-content: center;">
            See Details →
          </a>
        </div>

      </div>
    </div>
  </section>

  {/* Client Testimonials Section */}
  <section class="content-section fade-in" style="background: var(--color-bg-secondary); padding: var(--space-12) 0;">
    <div class="container">
      <div class="content-section__header">
        <span class="content-section__label">Client Endorsements</span>
        <h2 class="content-section__title">What Industrial Business Leaders Say</h2>
        <p class="content-section__text">Direct feedback from factory operations heads across major industrial belts.</p>
      </div>

      <div class="grid-2" style="gap: var(--space-6);">
        <div class="card" style="background: #ffffff; padding: var(--space-8); border-left: 4px solid var(--color-primary);">
          <p style="font-size: var(--font-size-base); font-style: italic; color: var(--color-text-primary); line-height: 1.6; margin-bottom: var(--space-4);">
            "OnLoop delivered exactly what they promised. Our monthly utility bill dropped by ₹4.2 Lakhs from month one, and the wind turbine runs through our night dyeing shifts without fail."
          </p>
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 42px; height: 42px; border-radius: 50%; background: var(--color-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700;">TM</div>
            <div>
              <strong style="font-size: 14px; display: block; color: var(--color-text-primary);">Managing Director</strong>
              <span style="font-size: 12px; color: var(--color-text-secondary);">Textile Dyeing Mill, Surat (India)</span>
            </div>
          </div>
        </div>

        <div class="card" style="background: #ffffff; padding: var(--space-8); border-left: 4px solid var(--color-primary);">
          <p style="font-size: var(--font-size-base); font-style: italic; color: var(--color-text-primary); line-height: 1.6; margin-bottom: var(--space-4);">
            "For our continuous roller kilns in Morbi, peak demand surcharges were killing our operating margins. OnLoop's 1.5MW hybrid system shaved our peak penalties by over 70%."
          </p>
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 42px; height: 42px; border-radius: 50%; background: var(--color-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700;">CM</div>
            <div>
              <strong style="font-size: 14px; display: block; color: var(--color-text-primary);">Plant Operations Head</strong>
              <span style="font-size: 12px; color: var(--color-text-secondary);">Ceramics & Tiles Plant, Morbi (India)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="cta-section fade-in">
    <div class="container">
      <div class="cta-section__content">
        <h2 class="cta-section__title">Ready to see what captive power can do for your facility?</h2>
        <p class="cta-section__text">Share your electricity bill details. Our engineering team will analyze your load curve and deliver a custom ROI model — free, zero obligation.</p>
        <a href="/contact" class="btn btn--primary btn--large">
          Get Your Free Savings Analysis
        </a>
      </div>
    </div>
  </section>

</div>
</AppLayout>
