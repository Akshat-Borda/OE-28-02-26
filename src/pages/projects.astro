---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Project Case Studies & ROI Portfolio | OnLoop Energy" description="Explore real project case studies, before vs. after monthly savings, and CapEx payback metrics from OnLoop Energy's captive wind and hybrid installations for C&I factories in Gujarat.">
<div>

  {/* Hero Section */}
  <section class="hero hero--short">
    <div class="container">
      <div class="hero__content">
        <div class="hero__badge" style="margin-top: var(--space-12);">
          <span class="hero__badge-dot"></span>
          Proven Project Portfolio
        </div>
        <h1 class="hero__title">
          Real projects. Real results.<br />
          <span class="hero__title-highlight">See how we cut power costs for private factories.</span>
        </h1>
        <p class="hero__subtitle">Every project below was evaluated on site-specific wind data, engineered for an industrial load profile, and executed turnkey by OnLoop Energy in Gujarat.</p>
      </div>
    </div>
  </section>

  {/* Explicit Exclusion Statement Trust Banner */}
  <div style="background: rgba(31, 183, 166, 0.08); border-top: 1px solid rgba(31, 183, 166, 0.2); border-bottom: 1px solid rgba(31, 183, 166, 0.2); padding: var(--space-4) 0;">
    <div class="container" style="text-align: center;">
      <p style="margin: 0; font-weight: 600; font-size: var(--font-size-base); color: var(--color-text-primary);">
        🛡️ <strong>Private B2B Portfolio:</strong> All installations below are private Commercial, Industrial, and MSME captive plants. We do not do residential or government tender projects.
      </p>
    </div>
  </div>

  {/* Client Testimonials Section */}
  <section class="content-section fade-in" style="background: var(--color-bg-secondary); padding: var(--space-10) 0;">
    <div class="container">
      <div class="content-section__header">
        <span class="content-section__label">Client Endorsements</span>
        <h2 class="content-section__title">What Factory Owners Say</h2>
        <p class="content-section__text">Direct feedback from industrial business leaders across Gujarat's manufacturing hubs.</p>
      </div>

      <div class="grid-2" style="gap: var(--space-6);">
        {/* Quote 1 */}
        <div class="card" style="background: #ffffff; padding: var(--space-8); border-left: 4px solid var(--color-primary);">
          <p style="font-size: var(--font-size-base); font-style: italic; color: var(--color-text-primary); line-height: 1.6; margin-bottom: var(--space-4);">
            "OnLoop delivered exactly what they promised. Our power bill dropped by ₹1.2 Lakhs from month one, and the wind turbine runs through our night dyeing shifts without fail."
