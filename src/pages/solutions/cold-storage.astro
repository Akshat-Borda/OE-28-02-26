---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Wind & Hybrid Energy for Cold Storage Facilities | Rajkot | OnLoop Energy" description="Slash 24/7 refrigeration power costs for cold storage and warehouse units in Rajkot & Gujarat. OnLoop Energy engineers captive wind turbine and hybrid energy systems.">
<div>

  {/* JSON-LD Schema Markup */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Captive Wind & Hybrid Energy Systems for Cold Storage Facilities",
    "provider": {
      "@type": "LocalBusiness",
      "name": "OnLoop Energy",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ahmedabad",
        "addressRegion": "Gujarat",
        "addressCountry": "IN"
      }
    },
    "areaServed": ["Rajkot", "Gondal", "Saurashtra", "Gujarat", "India"],
    "description": "Small wind turbine and hybrid captive power systems engineered to offset 24/7 refrigeration compressor loads for cold storage facilities."
  })} />

  {/* Hero Section */}
  <section class="hero hero--short">
    <div class="container">
      <div class="hero__content">
        <div class="hero__badge" style="margin-top: var(--space-12);">
          <span class="hero__badge-dot"></span>
          Cold Storage Industry Solutions
        </div>
        <h1 class="hero__title">
          Slash 24/7 refrigeration power bills with <span class="hero__title-highlight">nighttime captive wind power.</span>
        </h1>
        <p class="hero__subtitle">Engineered for cold storage warehouses, agricultural cold chains, and commercial refrigeration units in Rajkot, Gondal, and across Gujarat facing heavy non-stop power bills.</p>
      </div>
    </div>
  </section>

  {/* The Problem */}
  <section class="content-section fade-in">
    <div class="container">
      <div class="grid-2" style="align-items: center; gap: var(--space-12);">
        <div>
          <span class="content-section__label">Cold Storage Demands</span>
          <h2 class="content-section__title" style="margin-bottom: var(--space-6);">24/7 Compressor Loads & Night Electricity Bills</h2>
          <p class="content-section__text">
            Cold storage warehouses operate heavy ammonia and Freon compressors 24 hours a day to maintain sub-zero temperatures for produce, dairy, pharma, and seafood. Power accounts for over 50% of a cold storage facility’s total operating costs.
          </p>
          <p class="content-section__text" style="margin-top: var(--space-4);">
            While solar panels help offset midday cooling loads, compressors must run continuously through the night. Without generation after sunset, cold storage owners pay steep utility night tariffs that eat away profit margins.
          </p>
          <p class="content-section__text" style="margin-top: var(--space-4);">
            Saurashtra and Rajkot cold storage belts experience strong nighttime atmospheric wind currents — allowing captive wind turbines to provide crucial off-peak nighttime electricity generation.
          </p>
        </div>
        <div class="card" style="padding: var(--space-8); border-left: 4px solid var(--color-primary); background: var(--color-bg-light);">
          <h3 style="font-size: var(--font-size-xl); margin-bottom: var(--space-4);">Cold Storage Energy Impact</h3>
          <ul class="feature-list">
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>50%+ Operating Cost</strong> spent purely on electricity bills</span>
            </li>
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>12 Hours Night Draw</strong> — Heavy compressor load when solar is 0%</span>
            </li>
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>Spoilage Risk</strong> — Power failures risk millions in stored agricultural stock</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* The Solution */}
  <section class="content-section content-section--light fade-in">
    <div class="container">
      <div class="content-section__header">
        <span class="content-section__label">The OnLoop Solution</span>
        <h2 class="content-section__title">Nighttime Wind & Daytime Solar Hybrid</h2>
        <p class="content-section__text">How our captive wind turbines generate off-peak power during night shifts when solar output is zero.</p>
      </div>

      <div class="grid-3">
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Night Shift Offsetting</h4>
          <p class="card__text">Wind turbines capture nighttime atmospheric wind currents, powering cooling compressors during high-tariff night hours when solar panels are inactive.</p>
        </div>
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Grid Contract Shaving</h4>
          <p class="card__text">Reduces your maximum contract demand requirement with the utility, cutting fixed monthly demand penalty charges on your bill.</p>
        </div>
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Low Footprint Build</h4>
          <p class="card__text">Wind turbines require minimal land area on warehouse perimeters, preserving loading dock access and truck maneuvering bays.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Real Case Study Section */}
  <section class="content-section fade-in" style="background: #ffffff;">
    <div class="container">
      <div style="background: linear-gradient(135deg, #0a2840 0%, #0f3d5c 100%); color: #ffffff; border-radius: var(--radius-xl); padding: var(--space-10);">
        <div class="grid-2" style="align-items: center; gap: var(--space-8);">
          <div>
            <span style="color: var(--color-teal); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem;">Rajkot Cold Storage Case Study</span>
            <h2 style="color: #ffffff; font-size: var(--font-size-3xl); margin-top: var(--space-2); margin-bottom: var(--space-4);">Multi-Commodity Cold Storage, Rajkot</h2>
            <p style="color: rgba(255,255,255,0.85); line-height: 1.7; font-size: var(--font-size-base);">
              <strong>The Problem:</strong> A 5,000 MT agricultural cold storage facility near Rajkot was paying ₹8.2 Lakhs/month in power bills. Compressor night loads accounted for 60% of monthly energy draw.
            </p>
            <p style="color: rgba(255,255,255,0.85); line-height: 1.7; font-size: var(--font-size-base); margin-top: var(--space-3);">
              <strong>The Solution:</strong> OnLoop Energy engineered a 100kW direct-drive wind turbine + 40kW rooftop solar hybrid captive system to cover 24/7 compressor loads.
            </p>
          </div>

          <div style="background: rgba(255,255,255,0.08); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.15);">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4);">
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Monthly Savings</span>
                <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-teal);">₹2.1 Lakhs</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Payback Period</span>
                <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-green);">3.1 Years</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">System Size</span>
                <div style="font-size: 1.2rem; font-weight: 700; color: #ffffff;">100kW Wind + 40kW Solar</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Night Power Share</span>
                <div style="font-size: 1.2rem; font-weight: 700; color: #ffffff;">55% Night Coverage</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="cta-section fade-in">
    <div class="container">
      <div class="cta-section__content">
        <h2 class="cta-section__title">Operate a cold storage or refrigerated warehouse in Gujarat?</h2>
        <p class="cta-section__text">Request a free site wind assessment & compressor tariff savings report for your unit — no tenders, no pressure, just technical clarity.</p>
        <a href="/contact" class="btn btn--primary btn--large">
          Request Cold Storage Wind Feasibility
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>
  </section>

</div>
</AppLayout>
