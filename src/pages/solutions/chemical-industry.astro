---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Wind & Hybrid Energy for Chemical Plants | Ankleshwar & Vapi | OnLoop Energy" description="Reduce power overhead for chemical, pharmaceutical, and polymer processing plants in Ankleshwar, Vapi & Gujarat. OnLoop Energy engineers captive wind turbine and hybrid systems.">
<div>

  {/* JSON-LD Schema Markup */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Captive Wind & Hybrid Energy Systems for Chemical Plants",
    "provider": {
      "@type": "LocalBusiness",
      "name": "OnLoop Energy",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ahmedabad",
        "addressRegion": "Gujarat",
        "addressCountry": "IN"
      }
    },
    "areaServed": ["Ankleshwar", "Vapi", "Bharuch", "Gujarat", "India"],
    "description": "High-reliability wind turbine and hybrid captive power systems engineered for continuous chemical and pharma manufacturing plants."
  })} />

  {/* Hero Section */}
  <section class="hero hero--short">
    <div class="container">
      <div class="hero__content">
        <div class="hero__badge" style="margin-top: var(--space-12);">
          <span class="hero__badge-dot"></span>
          Chemical & Processing Industry Solutions
        </div>
        <h1 class="hero__title">
          High-uptime captive power for <span class="hero__title-highlight">continuous chemical & pharma plants.</span>
        </h1>
        <p class="hero__subtitle">Engineered for chemical processing, specialty chemical, and pharma manufacturing units in Ankleshwar, Vapi, and Bharuch requiring absolute power reliability and lower utility expenses.</p>
      </div>
    </div>
  </section>

  {/* The Problem */}
  <section class="content-section fade-in">
    <div class="container">
      <div class="grid-2" style="align-items: center; gap: var(--space-12);">
        <div>
          <span class="content-section__label">Chemical Industry Demands</span>
          <h2 class="content-section__title" style="margin-bottom: var(--space-6);">High Baseline Power & Strict Environmental Standards</h2>
          <p class="content-section__text">
            Chemical processing plants operate batch reactors, chillers, distillation columns, and effluent treatment plants (ETP) around the clock. Electrical instability or high tariff spikes directly increase per-kilo production costs in price-sensitive chemical markets.
          </p>
          <p class="content-section__text" style="margin-top: var(--space-4);">
            Chemical plants face stringent ESG, carbon reporting, and corporate sustainability metrics. Solar rooftop panels alone offer limited daytime displacement and are often constrained by chemical plant roof piping, vents, and safety hazard zones.
          </p>
          <p class="content-section__text" style="margin-top: var(--space-4);">
            Ankleshwar, Dahej, and Vapi industrial belts benefit from high coastal and corridor wind channels that allow ground-mount or perimeter captive wind turbines to generate consistent power day and night.
          </p>
        </div>
        <div class="card" style="padding: var(--space-8); border-left: 4px solid var(--color-primary); background: var(--color-bg-light);">
          <h3 style="font-size: var(--font-size-xl); margin-bottom: var(--space-4);">Chemical Energy Impact</h3>
          <ul class="feature-list">
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>Strict Uptime Needs</strong> — Chiller & ETP shutdown leads to chemical spoil</span>
            </li>
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>Roof Hazards</strong> — Chemical fumes restrict large rooftop solar arrays</span>
            </li>
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>ESG Compliance</strong> — Buyer mandates for verified renewable energy footprint</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* The Solution */}
  <section class="content-section content-section--light fade-in">
    <div class="container">
      <div class="content-section__header">
        <span class="content-section__label">The OnLoop Solution</span>
        <h2 class="content-section__title">Safe, Perimeter Wind-Hybrid Architecture</h2>
        <p class="content-section__text">How we engineer captive wind systems clear of chemical hazard zones to deliver 24/7 power.</p>
      </div>

      <div class="grid-3">
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Perimeter Deployment</h4>
          <p class="card__text">Our captive wind turbines are installed along plant perimeters or ground plots, keeping rooftop chemical vents clear while capturing uninhibited wind flow.</p>
        </div>
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Zero Spark Hazard</h4>
          <p class="card__text">Direct-drive Permanent Magnet Alternators with sealed nacelles eliminate mechanical brush friction and spark hazards, meeting industrial chemical safety standards.</p>
        </div>
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">ESG & Carbon Offsets</h4>
          <p class="card__text">Delivers verifiable 24/7 clean energy certificates to meet multinational pharmaceutical and chemical buyer audit compliance.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Real Case Study Section */}
  <section class="content-section fade-in" style="background: #ffffff;">
    <div class="container">
      <div style="background: linear-gradient(135deg, #0a2840 0%, #0f3d5c 100%); color: #ffffff; border-radius: var(--radius-xl); padding: var(--space-10);">
        <div class="grid-2" style="align-items: center; gap: var(--space-8);">
          <div>
            <span style="color: var(--color-teal); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem;">Ankleshwar Chemical Case Study</span>
            <h2 style="color: #ffffff; font-size: var(--font-size-3xl); margin-top: var(--space-2); margin-bottom: var(--space-4);">Specialty Chemical Plant, Ankleshwar GIDC</h2>
            <p style="color: rgba(255,255,255,0.85); line-height: 1.7; font-size: var(--font-size-base);">
              <strong>The Problem:</strong> A specialty chemical manufacturer in Ankleshwar GIDC was spending ₹14.8 Lakhs/month on electricity. Rooftop space was unusable due to acid scrubber vents, and night shift chiller loads drove heavy tariffs.
            </p>
            <p style="color: rgba(255,255,255,0.85); line-height: 1.7; font-size: var(--font-size-base); margin-top: var(--space-3);">
              <strong>The Solution:</strong> OnLoop Energy engineered a perimeter 200kW direct-drive wind turbine + ground-mount solar hybrid system connected directly to their main LT distribution panel.
            </p>
          </div>

          <div style="background: rgba(255,255,255,0.08); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.15);">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4);">
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Monthly Savings</span>
                <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-teal);">₹4.0 Lakhs</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Payback Period</span>
                <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-green);">3.4 Years</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">System Size</span>
                <div style="font-size: 1.2rem; font-weight: 700; color: #ffffff;">200kW Hybrid System</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Carbon Offset</span>
                <div style="font-size: 1.2rem; font-weight: 700; color: #ffffff;">280 Tons / Year</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="cta-section fade-in">
    <div class="container">
      <div class="cta-section__content">
        <h2 class="cta-section__title">Run a chemical or pharma plant in Ankleshwar, Vapi, or Bharuch?</h2>
        <p class="cta-section__text">Request a perimeter wind assessment & electrical tariff reduction report for your plant — zero cost, no tenders, full engineering clarity.</p>
        <a href="/contact" class="btn btn--primary btn--large">
          Request Chemical Wind Feasibility
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>
  </section>

</div>
</AppLayout>
