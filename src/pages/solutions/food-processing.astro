---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Wind & Hybrid Energy for Food Processing | Gujarat | OnLoop Energy" description="Lower power costs for agro, dairy, and food processing plants across Gujarat. OnLoop Energy engineers captive small wind and hybrid systems for seasonal and 24/7 food processing.">
<div>

  {/* JSON-LD Schema Markup */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Captive Wind & Hybrid Energy Systems for Food Processing Units",
    "provider": {
      "@type": "LocalBusiness",
      "name": "OnLoop Energy",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ahmedabad",
        "addressRegion": "Gujarat",
        "addressCountry": "IN"
      }
    },
    "areaServed": ["Anand", "Rajkot", "Ahmedabad", "Gujarat", "India"],
    "description": "Small wind turbine and hybrid energy systems engineered to lower power costs for food processing, agro processing, and dairy plants."
  })} />

  {/* Hero Section */}
  <section class="hero hero--short">
    <div class="container">
      <div class="hero__content">
        <div class="hero__badge" style="margin-top: var(--space-12);">
          <span class="hero__badge-dot"></span>
          Food Processing Industry Solutions
        </div>
        <h1 class="hero__title">
          Cut seasonal & night power bills with <span class="hero__title-highlight">captive wind & hybrid energy.</span>
        </h1>
        <p class="hero__subtitle">Engineered for food processing, agro-processing, dairy, and beverage facilities in Anand, Rajkot, and across Gujarat requiring high power reliability during peak harvest seasons.</p>
      </div>
    </div>
  </section>

  {/* The Problem */}
  <section class="content-section fade-in">
    <div class="container">
      <div class="grid-2" style="align-items: center; gap: var(--space-12);">
        <div>
          <span class="content-section__label">Food Processing Demands</span>
          <h2 class="content-section__title" style="margin-bottom: var(--space-6);">Seasonal Harvest Spikes & Monsoon Solar Drops</h2>
          <p class="content-section__text">
            Food processing plants experience sharp seasonal production spikes during harvest months. Freezers, dehydration units, pasteurizers, and sorting lines operate continuously to process perishable raw crops before spoil occurs.
          </p>
          <p class="content-section__text" style="margin-top: var(--space-4);">
            During the monsoon season, when agricultural processing is at its peak in Gujarat, cloudy skies reduce solar panel generation by up to 70%. Relying solely on solar power leaves food processors exposed to heavy grid demand tariffs during peak operating months.
          </p>
          <p class="content-section__text" style="margin-top: var(--space-4);">
            Wind energy generation in Gujarat reaches peak annual velocity precisely during monsoon harvest months — providing perfect seasonal alignment for food processing units.
          </p>
        </div>
        <div class="card" style="padding: var(--space-8); border-left: 4px solid var(--color-primary); background: var(--color-bg-light);">
          <h3 style="font-size: var(--font-size-xl); margin-bottom: var(--space-4);">Food Processing Energy Impact</h3>
          <ul class="feature-list">
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>Monsoon Solar Drop</strong> — 70% reduction in solar output during peak harvest</span>
            </li>
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>Perishable Risk</strong> — Power dropouts compromise pasteurization and freezing</span>
            </li>
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>Seasonal Demand Spikes</strong> — High utility contract demand charges</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* The Solution */}
  <section class="content-section content-section--light fade-in">
    <div class="container">
      <div class="content-section__header">
        <span class="content-section__label">The OnLoop Solution</span>
        <h2 class="content-section__title">Monsoon-Strong Wind & Hybrid Systems</h2>
        <p class="content-section__text">How our small wind turbines generate power when solar output drops, protecting your seasonal profits.</p>
      </div>

      <div class="grid-3">
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Harvest Season Wind Peak</h4>
          <p class="card__text">Wind speeds in Gujarat are highest during monsoon and summer months, providing maximum power output exactly when food processing plants run at full capacity.</p>
        </div>
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Thermal Compliance</h4>
          <p class="card__text">Delivers steady 24/7 power to refrigeration compressors and chillers, maintaining strict FSSAI food safety cold chain compliance.</p>
        </div>
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Agro Land Dual-Use</h4>
          <p class="card__text">Small wind turbines feature compact footings (under 25 sq. ft.), allowing raw crop storage or vehicle parking beneath turbine towers.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Real Case Study Section */}
  <section class="content-section fade-in" style="background: #ffffff;">
    <div class="container">
      <div style="background: linear-gradient(135deg, #0a2840 0%, #0f3d5c 100%); color: #ffffff; border-radius: var(--radius-xl); padding: var(--space-10);">
        <div class="grid-2" style="align-items: center; gap: var(--space-8);">
          <div>
            <span style="color: var(--color-teal); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem;">Anand Food Processing Case Study</span>
            <h2 style="color: #ffffff; font-size: var(--font-size-3xl); margin-top: var(--space-2); margin-bottom: var(--space-4);">Fruit Dehydration & Processing Unit, Anand</h2>
            <p style="color: rgba(255,255,255,0.85); line-height: 1.7; font-size: var(--font-size-base);">
              <strong>The Problem:</strong> An agro-processing plant near Anand was paying ₹6.5 Lakhs/month in summer and monsoon power bills. Monsoon solar drops forced heavy reliance on expensive grid power during peak dehydration cycles.
            </p>
            <p style="color: rgba(255,255,255,0.85); line-height: 1.7; font-size: var(--font-size-base); margin-top: var(--space-3);">
              <strong>The Solution:</strong> OnLoop Energy installed a 75kW direct-drive wind turbine + 30kW solar hybrid plant, balancing monsoon wind generation with sunny day solar output.
            </p>
          </div>

          <div style="background: rgba(255,255,255,0.08); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.15);">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4);">
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Monthly Savings</span>
                <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-teal);">₹1.8 Lakhs</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Payback Period</span>
                <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-green);">3.3 Years</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">System Size</span>
                <div style="font-size: 1.2rem; font-weight: 700; color: #ffffff;">75kW Wind + 30kW Solar</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Harvest Reliability</span>
                <div style="font-size: 1.2rem; font-weight: 700; color: #ffffff;">100% Monsoon Uptime</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="cta-section fade-in">
    <div class="container">
      <div class="cta-section__content">
        <h2 class="cta-section__title">Operate a food processing or agro facility in Gujarat?</h2>
        <p class="cta-section__text">Request a free site wind assessment tailored to your seasonal processing schedule — no tenders, no pressure, just engineering.</p>
        <a href="/contact" class="btn btn--primary btn--large">
          Request Food Processing Wind Feasibility
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>
  </section>

</div>
</AppLayout>
