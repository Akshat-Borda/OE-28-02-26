---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Wind & Hybrid Energy for Ceramics & Tiles Plants | Morbi | OnLoop Energy" description="Lower power costs for ceramics, wall tile, and sanitaryware manufacturing plants in Morbi & Gujarat. OnLoop Energy engineers captive small wind and hybrid systems for 24/7 continuous kilns.">
<div>

  {/* JSON-LD Schema Markup */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Captive Wind & Hybrid Energy Systems for Ceramics Plants",
    "provider": {
      "@type": "LocalBusiness",
      "name": "OnLoop Energy",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ahmedabad",
        "addressRegion": "Gujarat",
        "addressCountry": "IN"
      }
    },
    "areaServed": ["Morbi", "Rajkot", "Gujarat", "India"],
    "description": "Custom small wind turbine and hybrid energy systems engineered to shave peak demand penalties and power 24/7 continuous kilns for ceramics manufacturing."
  })} />

  {/* Hero Section */}
  <section class="hero hero--short">
    <div class="container">
      <div class="hero__content">
        <div class="hero__badge" style="margin-top: var(--space-12);">
          <span class="hero__badge-dot"></span>
          Ceramics & Tiles Industry Solutions
        </div>
        <h1 class="hero__title">
          Power 24/7 continuous kilns with <span class="hero__title-highlight">captive wind & hybrid energy.</span>
        </h1>
        <p class="hero__subtitle">Engineered specifically for ceramics, vitrified tile, and sanitaryware plants in Morbi and across Gujarat facing heavy peak demand charges and continuous electrical loads.</p>
      </div>
    </div>
  </section>

  {/* The Problem */}
  <section class="content-section fade-in">
    <div class="container">
      <div class="grid-2" style="align-items: center; gap: var(--space-12);">
        <div>
          <span class="content-section__label">Morbi Industrial Realities</span>
          <h2 class="content-section__title" style="margin-bottom: var(--space-6);">24/7 Kilns & Massive Peak Demand Penalties</h2>
          <p class="content-section__text">
            Morbi produces over 70% of India’s ceramic tiles. Roller kilns, ball mills, spray dryers, and polishing lines run 24 hours a day, 365 days a year. Shutting down a kiln due to power grid drops causes thermal shock and millions of rupees in lost production batches.
          </p>
          <p class="content-section__text" style="margin-top: var(--space-4);">
            Commercial solar panels provide relief only during midday hours. But when evening shift peak demand strikes, utility peak tariffs shoot up — hitting tile manufacturers with severe demand penalty charges on their monthly electricity bills.
          </p>
          <p class="content-section__text" style="margin-top: var(--space-4);">
            Morbi's unique coastal-adjacent topography offers exceptional year-round wind resource velocity — perfect for high-yield captive wind turbines operating at 20-30m hub heights.
          </p>
        </div>
        <div class="card" style="padding: var(--space-8); border-left: 4px solid var(--color-primary); background: var(--color-bg-light);">
          <h3 style="font-size: var(--font-size-xl); margin-bottom: var(--space-4);">Ceramics Energy Impact</h3>
          <ul class="feature-list">
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>24/7 Continuous Load</strong> — Kilns cannot be turned off at night</span>
            </li>
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>₹10–15 Lakhs/month</strong> average electricity bill for medium ceramic units</span>
            </li>
            <li class="feature-item" style="border: none; padding: var(--space-2) 0;">
              <span class="feature-item__text"><strong>Heavy Peak Surcharges</strong> levied on night & morning demand spikes</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* The Solution */}
  <section class="content-section content-section--light fade-in">
    <div class="container">
      <div class="content-section__header">
        <span class="content-section__label">The OnLoop Solution</span>
        <h2 class="content-section__title">Wind-First Captive Power for Ceramics Plants</h2>
        <p class="content-section__text">How our small wind turbines and wind-solar hybrid architectures shave peak demand and slash monthly utility bills.</p>
      </div>

      <div class="grid-3">
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Peak Demand Shaving</h4>
          <p class="card__text">Wind generation peaks during evening and night hours, absorbing kiln power draw and capping maximum demand spikes before utility billing thresholds are crossed.</p>
        </div>
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">Direct-Drive Reliability</h4>
          <p class="card__text">Our Permanent Magnet Alternator (PMA) turbines feature no mechanical gearboxes, ensuring >98% operational uptime in dusty industrial environments like ceramic clusters.</p>
        </div>
        <div class="card" style="padding: var(--space-6);">
          <h4 class="card__title">3.0 Year Payback</h4>
          <p class="card__text">Combined with 60% Accelerated Depreciation tax benefits under Section 32, Morbi ceramic plants achieve complete CapEx payback in under 36 months.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Real Case Study Section */}
  <section class="content-section fade-in" style="background: #ffffff;">
    <div class="container">
      <div style="background: linear-gradient(135deg, #0a2840 0%, #0f3d5c 100%); color: #ffffff; border-radius: var(--radius-xl); padding: var(--space-10);">
        <div class="grid-2" style="align-items: center; gap: var(--space-8);">
          <div>
            <span style="color: var(--color-teal); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem;">Morbi Ceramics Case Study</span>
            <h2 style="color: #ffffff; font-size: var(--font-size-3xl); margin-top: var(--space-2); margin-bottom: var(--space-4);">Vitrified Tile Manufacturer, Morbi</h2>
            <p style="color: rgba(255,255,255,0.85); line-height: 1.7; font-size: var(--font-size-base);">
              <strong>The Problem:</strong> A vitrified tile plant on Morbi-Halvad Road was paying ₹11.5 Lakhs/month in power bills. Kiln night shifts and peak demand surcharges severely eroded export competitiveness.
            </p>
            <p style="color: rgba(255,255,255,0.85); line-height: 1.7; font-size: var(--font-size-base); margin-top: var(--space-3);">
              <strong>The Solution:</strong> OnLoop Energy engineered a 150kW direct-drive wind turbine + 50kW rooftop solar hybrid captive system, sharing electrical protection and metering infrastructure.
            </p>
          </div>

          <div style="background: rgba(255,255,255,0.08); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.15);">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4);">
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Monthly Savings</span>
                <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-teal);">₹3.5 Lakhs</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">Payback Period</span>
                <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-green);">3.0 Years</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">System Size</span>
                <div style="font-size: 1.2rem; font-weight: 700; color: #ffffff;">150kW Wind + 50kW Solar</div>
              </div>
              <div>
                <span style="font-size: 0.75rem; color: rgba(255,255,255,0.6); text-transform: uppercase; font-weight: 600;">CUF Achieved</span>
                <div style="font-size: 1.2rem; font-weight: 700; color: #ffffff;">38% Hybrid CUF</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="cta-section fade-in">
    <div class="container">
      <div class="cta-section__content">
        <h2 class="cta-section__title">Operate a ceramic or tile plant in Morbi? Let's check your site's wind speed.</h2>
        <p class="cta-section__text">Request a complimentary site wind resource and ROI estimate for your factory — no tenders, no pressure, just engineering.</p>
        <a href="/contact" class="btn btn--primary btn--large">
          Request Ceramics Wind Feasibility
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>
  </section>

</div>
</AppLayout>
