---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Power Your Factory | Wind & Hybrid Energy for C&I and MSMEs | OnLoop Energy" description="OnLoop Energy designs wind-first, hybrid-optimized captive power systems exclusively for Commercial, Industrial, and MSME facilities. Cut energy costs — no tenders, no bureaucracy, just site-specific engineering.">
<div>
      

      




      {/* Hero Section */}
      <section class="hero hero--image" style="background-image: url('/images/stock/solarfarm.webp');">
        <div class="container">
          <div class="hero__content">
            <div class="hero__badge" style="margin-top: var(--space-8);">
              <span class="hero__badge-dot"></span>
              Wind & Hybrid Energy for C&I and MSMEs
            </div>
            <h1 class="hero__title">
              Power Your Factory, Not the Bureaucracy.<br />
              <span class="hero__title-highlight">Wind & Hybrid Energy for C&I and MSMEs.</span>
            </h1>
            <p class="hero__subtitle">Engineering-first renewable energy — no tenders, no residential.</p>
            
            <div style="background: rgba(255, 255, 255, 0.1); border-left: 3px solid var(--color-primary); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); margin-bottom: var(--space-6); max-width: 680px;">
              <p style="margin: 0; font-size: var(--font-size-sm); color: rgba(255, 255, 255, 0.9); font-weight: 500;">
                <strong>Cut energy costs. Secure your production.</strong> No tenders, no red tape — just engineering.
              </p>
            </div>

            <div class="hero__actions">
              <a href="/contact" class="btn btn--primary btn--large">Get Your Free Savings Analysis</a>
              <a href="/wind" class="btn btn--secondary btn--large">Explore Wind & Hybrid</a>
            </div>
          </div>
        </div>
        {/* Decorative visual element */}
        <div class="hero__visual">
          <div class="hero__graphic">
            <div class="hero__graphic-circle"></div>
            <div class="hero__graphic-circle"></div>
            <div class="hero__graphic-circle"></div>
          </div>
        </div>
      </section>

      {/* Explicit Exclusion Statement Trust Banner */}
      <div style="background: rgba(31, 183, 166, 0.08); border-top: 1px solid rgba(31, 183, 166, 0.2); border-bottom: 1px solid rgba(31, 183, 166, 0.2); padding: var(--space-4) 0;">
        <div class="container" style="text-align: center;">
          <p style="margin: 0; font-weight: 600; font-size: var(--font-size-base); color: var(--color-text-primary);">
            🛡️ <strong>Exclusively Private B2B:</strong> Commercial, Industrial & MSME only. No residential. No government.
          </p>
        </div>
      </div>

      {/* Intro / 3 Data-Driven Value Propositions */}
      <section class="content-section fade-in" style="padding: var(--space-10) 0;">
        <div class="container">
          <div class="content-section__header container--narrow" style="text-align: center; margin-bottom: var(--space-8);">
            <span class="content-section__label">Proven Impact</span>
            <h2 class="content-section__title">Real Data. Real Industrial Savings.</h2>
            <p class="content-section__text">We build captive power systems engineered around what your factory actually gets.</p>
          </div>

          <div class="grid-3" style="gap: var(--space-6);">
            {/* Value Prop 1 */}
            <div class="card" style="padding: var(--space-6); border-top: 4px solid var(--color-primary); background: #ffffff;">
              <div style="font-size: 1.8rem; margin-bottom: var(--space-2);">🧵</div>
              <h4 class="card__title" style="font-size: var(--font-size-lg); margin-bottom: var(--space-2);">Textile & Dyeing Mills</h4>
              <p class="card__text" style="font-size: var(--font-size-base); font-weight: 700; color: var(--color-primary); margin-bottom: 0;">
                Textile dyeing units save ₹1.2 Lakhs/month
              </p>
              <p style="font-size: 13px; color: var(--color-text-secondary); margin-top: 6px;">By offsetting night shift dyeing jet tariffs with wind power.</p>
            </div>

            {/* Value Prop 2 */}
            <div class="card" style="padding: var(--space-6); border-top: 4px solid var(--color-primary); background: #ffffff;">
              <div style="font-size: 1.8rem; margin-bottom: var(--space-2);">🧱</div>
              <h4 class="card__title" style="font-size: var(--font-size-lg); margin-bottom: var(--space-2);">Ceramics & Tiles Plants</h4>
              <p class="card__text" style="font-size: var(--font-size-base); font-weight: 700; color: var(--color-primary); margin-bottom: 0;">
                Ceramic plants cut peak demand by 40%
              </p>
              <p style="font-size: 13px; color: var(--color-text-secondary); margin-top: 6px;">Shaving peak surcharges on 24/7 continuous roller kilns.</p>
            </div>

            {/* Value Prop 3 */}
            <div class="card" style="padding: var(--space-6); border-top: 4px solid var(--color-primary); background: #ffffff;">
              <div style="font-size: 1.8rem; margin-bottom: var(--space-2);">🧪</div>
              <h4 class="card__title" style="font-size: var(--font-size-lg); margin-bottom: var(--space-2);">Chemical & Processing</h4>
              <p class="card__text" style="font-size: 14px; font-weight: 700; color: var(--color-primary); margin-bottom: 0;">
                Chemical facilities achieve 24/7 power security
              </p>
              <p style="font-size: 13px; color: var(--color-text-secondary); margin-top: 6px;">Safe perimeter wind generation for continuous chiller loads.</p>
            </div>
          </div>
        </div>
      </section>

      {/* Solutions for Your Industry */}
      <section class="content-section content-section--light fade-in">
        <div class="container">
          <div class="content-section__header">
            <span class="content-section__label">Industry Solutions</span>
            <h2 class="content-section__title">Solutions for Your Industry</h2>
            <p class="content-section__text">We don't sell generic energy packages. Explore how we solve power challenges for your specific manufacturing sector.</p>
          </div>

          <div class="grid-3" style="gap: var(--space-6);">
            {/* Textile */}
            <a href="/solutions/textile-industry" class="card" style="text-decoration: none; color: inherit; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L3 12.5V21h8.5l8.74-8.76z" />
                </svg>
              </div>
              <h4 class="card__title" style="margin-bottom: var(--space-2);">Textile & Dyeing Mills</h4>
              <p class="card__text" style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: var(--space-4);">Cut night shift dyeing tariff costs in Surat & Gujarat mills.</p>
              <span style="color: var(--color-primary); font-weight: 600; font-size: 14px;">Explore Textile Solutions →</span>
            </a>

            {/* Ceramics */}
            <a href="/solutions/ceramics-industry" class="card" style="text-decoration: none; color: inherit; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                  <path d="M3 9h18" />
                  <path d="M9 21V9" />
                </svg>
              </div>
              <h4 class="card__title" style="margin-bottom: var(--space-2);">Ceramics & Tiles</h4>
              <p class="card__text" style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: var(--space-4);">Shave peak demand for 24/7 continuous kilns in Morbi.</p>
              <span style="color: var(--color-primary); font-weight: 600; font-size: 14px;">Explore Ceramics Solutions →</span>
            </a>

            {/* Chemical */}
            <a href="/solutions/chemical-industry" class="card" style="text-decoration: none; color: inherit; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 2v7.31L4.75 20.5a2 2 0 0 0 1.71 3h11.08a2 2 0 0 0 1.71-3L14 9.31V2" />
                </svg>
              </div>
              <h4 class="card__title" style="margin-bottom: var(--space-2);">Chemical & Processing</h4>
              <p class="card__text" style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: var(--space-4);">High-uptime perimeter wind plants in Ankleshwar & Vapi.</p>
              <span style="color: var(--color-primary); font-weight: 600; font-size: 14px;">Explore Chemical Solutions →</span>
            </a>

            {/* Food Processing */}
            <a href="/solutions/food-processing" class="card" style="text-decoration: none; color: inherit; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              </div>
              <h4 class="card__title" style="margin-bottom: var(--space-2);">Food Processing Units</h4>
              <p class="card__text" style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: var(--space-4);">Offset monsoon harvest solar drops with peak seasonal wind.</p>
              <span style="color: var(--color-primary); font-weight: 600; font-size: 14px;">Explore Food Solutions →</span>
            </a>

            {/* Cold Storage */}
            <a href="/solutions/cold-storage" class="card" style="text-decoration: none; color: inherit; transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v18M3 12h18" />
                </svg>
              </div>
              <h4 class="card__title" style="margin-bottom: var(--space-2);">Cold Storage & Logistics</h4>
              <p class="card__text" style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: var(--space-4);">24/7 refrigeration compressor power in Rajkot & Saurashtra.</p>
              <span style="color: var(--color-primary); font-weight: 600; font-size: 14px;">Explore Cold Storage →</span>
            </a>

            {/* Case Studies Card */}
            <a href="/projects" class="card" style="text-decoration: none; color: inherit; background: var(--color-bg-light); border: 2px dashed var(--color-primary); transition: transform 0.2s ease;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                </svg>
              </div>
              <h4 class="card__title" style="margin-bottom: var(--space-2);">Real Case Studies</h4>
              <p class="card__text" style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: var(--space-4);">See ₹1.2L–₹4.0L/mo savings and payback metrics.</p>
              <span style="color: var(--color-primary); font-weight: 700; font-size: 14px;">View Project Portfolio →</span>
            </a>
          </div>

          <div style="text-align: center; margin-top: var(--space-8);">
            <a href="/solutions" class="btn btn--secondary">View Full Industry Hub & Overview →</a>
          </div>
        </div>
      </section>

      {/* Solutions Overview */}
      <section class="content-section fade-in">
        <div class="container">
          <div class="content-section__header">
            <span class="content-section__label">Solutions Overview</span>
            <h2 class="content-section__title">Wind. Hybrid. Nothing Else.</h2>
            <p class="content-section__text">We focus on two technologies: captive wind energy and hybrid (wind + solar) systems. No BESS, no pure solar, no residential. Every solution is engineered for a specific C&I context.</p>
          </div>
          <div class="grid-3">
            <div class="image-card">
              <img src="https://images.unsplash.com/photo-1532601224476-15c79f2f7a51?w=600&h=400&fit=crop"
                alt="Commercial wind energy site-specific turbine installation for industrial facility" loading="lazy" />
              <div class="image-card__caption">
                <h4>Captive Wind Turbine Systems</h4>
                <p>Deployed only at sites where wind resource data genuinely supports long-term performance. Generates power 24/7 — including nights, weekends, and monsoon season when solar output is zero.</p>
              </div>
            </div>
            <div class="image-card">
              <img src="https://images.unsplash.com/photo-1466611653911-95081537e5b7?w=600&h=400&fit=crop"
                alt="Hybrid wind and solar energy system for commercial and industrial facility" loading="lazy" />
              <div class="image-card__caption">
                <h4>Hybrid Energy Systems (Wind + Solar)</h4>
                <p>A single engineered architecture combining daytime solar with wind generation across the full diurnal and seasonal cycle. Higher CUF, better land utilization, and true 24/7 coverage for demanding C&I loads.</p>
              </div>
            </div>
            <div class="image-card">
              <img src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=600&h=400&fit=crop"
                alt="Solar panels as part of a hybrid energy system for industrial use" loading="lazy" />
              <div class="image-card__caption">
                <h4>Solar — Only Within Hybrid</h4>
                <p>We use solar as the daytime generation layer in our hybrid systems. We do not install solar-only systems. If your load profile calls for solar-only, we will tell you honestly and point you to the right specialist.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Compressed Philosophy & Track Record Block */}
      <section class="content-section content-section--light fade-in">
        <div class="container">
          {/* Philosophy Statement */}
          <div style="max-width: 800px; margin: 0 auto; text-align: center; margin-bottom: var(--space-12);">
            <span class="content-section__label">Our Philosophy</span>
            <h2 class="content-section__title" style="margin-bottom: var(--space-4);">We start with your bill data, not our product catalog.</h2>
            <div style="display: flex; justify-content: center; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-4);">
              <span style="background: rgba(31, 183, 166, 0.12); color: var(--color-primary); font-weight: 700; padding: var(--space-2) var(--space-5); border-radius: 20px; font-size: 0.95rem;">Data-Driven</span>
              <span style="background: rgba(31, 183, 166, 0.12); color: var(--color-primary); font-weight: 700; padding: var(--space-2) var(--space-5); border-radius: 20px; font-size: 0.95rem;">Site-Specific</span>
              <span style="background: rgba(31, 183, 166, 0.12); color: var(--color-primary); font-weight: 700; padding: var(--space-2) var(--space-5); border-radius: 20px; font-size: 0.95rem;">Zero Bias</span>
            </div>
          </div>

          {/* New "Trusted By / Track Record" Metrics Block */}
          <div style="background: #ffffff; padding: var(--space-8); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); border: 1px solid var(--glass-border);">
            <div style="text-align: center; margin-bottom: var(--space-6);">
              <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 1px;">Proven Track Record</span>
              <h3 style="font-size: var(--font-size-xl); margin-top: 4px;">Trusted Across Gujarat’s Major Industrial Belts</h3>
            </div>
            <div class="grid-4" style="text-align: center; gap: var(--space-6);">
              <div>
                <div style="font-size: 2.2rem; font-weight: 800; color: var(--color-primary);">20+</div>
                <p style="font-size: 14px; color: var(--color-text-secondary); margin: 0; font-weight: 500;">Installations Across Gujarat</p>
              </div>
              <div>
                <div style="font-size: 2.2rem; font-weight: 800; color: var(--color-primary);">5</div>
                <p style="font-size: 14px; color: var(--color-text-secondary); margin: 0; font-weight: 500;">Key Sectors (Textile, Ceramics, Chemical, Food, Cold Storage)</p>
              </div>
              <div>
                <div style="font-size: 2.2rem; font-weight: 800; color: var(--color-primary);">35%+</div>
                <p style="font-size: 14px; color: var(--color-text-secondary); margin: 0; font-weight: 500;">Avg. Hybrid CUF (vs ~20% solar alone)</p>
              </div>
              <div>
                <div style="font-size: 2.2rem; font-weight: 800; color: #10b981;"><3.5 Yrs</div>
                <p style="font-size: 14px; color: var(--color-text-secondary); margin: 0; font-weight: 500;">Average CapEx Payback Period</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 3-Step MSME Onboarding Flow */}
      <section class="content-section fade-in" style="background: var(--color-bg-light);">
        <div class="container">
          <div class="content-section__header" style="max-width: 900px;">
            <span class="content-section__label">Simple 3-Step Process</span>
            <h2 class="content-section__title">How We Partner With MSMEs & Factories</h2>
          </div>
          <div class="grid-3" style="align-items: stretch;">
            {/* Step 1 */}
            <div class="card" style="background: #ffffff; padding: var(--space-8); position: relative;">
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--color-primary); position: absolute; top: 16px; right: 20px;">Step 1</div>
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
              </div>
              <h4 class="card__title">1. Share Your Electricity Bill</h4>
              <p class="card__text">Upload or send your recent utility bill and facility location. We analyze your tariff rates, peak demand charges, and consumption curve.</p>
            </div>
            {/* Step 2 */}
            <div class="card" style="background: #ffffff; padding: var(--space-8); position: relative;">
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--color-primary); position: absolute; top: 16px; right: 20px;">Step 2</div>
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2" />
                </svg>
              </div>
              <h4 class="card__title">2. Load Profile Analysis</h4>
              <p class="card__text">Our engineers analyze your tariff structure, consumption patterns, and peak demand charges. We identify the exact savings opportunity.</p>
            </div>
            {/* Step 3 */}
            <div class="card" style="background: #ffffff; padding: var(--space-8); position: relative;">
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--color-primary); position: absolute; top: 16px; right: 20px;">Step 3</div>
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
              </div>
              <h4 class="card__title">3. Captive Hybrid Engineering</h4>
              <p class="card__text">We engineer, install, and commission your site-specific captive power plant — delivering measurable monthly savings from day one.</p>
            </div>
          </div>
          <div style="text-align: center; margin-top: var(--space-8);">
            <a href="/contact" class="btn btn--primary btn--large">Get Your Free Savings Analysis</a>
          </div>
        </div>
      </section>

      {/* Why OnLoop */}
      <section class="content-section content-section--light fade-in">
        <div class="container">
          <div class="content-section__header">
            <span class="content-section__label">Why OnLoop Energy</span>
            <h2 class="content-section__title">Built for long-term performance</h2>
          </div>
          <div class="grid-3">
            <div class="card card--light">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.5">
                  <path
                    d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                </svg>
              </div>
              <h4 class="card__title">Engineering-led</h4>
              <p class="card__text">
                Every recommendation is backed by technical validation and site data.</p>
            </div>
            <div class="card card--light">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.5">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                  <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
              </div>
              <h4 class="card__title">Honest Assessment</h4>
              <p class="card__text">
                We tell you what works — and what doesn't — upfront. If wind or hybrid doesn't fit your load profile, we say so.</p>
            </div>
            <div class="card card--light">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.5">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </div>
              <h4 class="card__title">Load-First Engineering</h4>
              <p class="card__text">
                No templates. We study your specific load profiles and tariff structure to build a custom
                energy architecture.</p>
            <div class="card card--light">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.5">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <polyline points="16 11 18 13 22 9" />
                </svg>
              </div>
              <h4 class="card__title">Single Accountability</h4>
              <p class="card__text">
                We take ownership of the entire lifecycle, from initial savings analysis to long-term
                operations.</p>
            </div>
            <div class="card card--light">
              <div class="card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.5">
                  <rect x="2" y="7" width="20" height="15" rx="2" ry="2" />
                  <polyline points="17 2 12 7 7 2" />
                </svg>
              </div>
              <h4 class="card__title">Wind-First Thinking</h4>
